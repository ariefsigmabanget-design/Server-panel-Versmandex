local Scroll1 = Instance.new("ScrollingFrame")
Scroll1.Parent = ListFrame1
Scroll1.BackgroundTransparency = 1
Scroll1.Position = UDim2.new(0.02, 0, 0.03, 0)
Scroll1.Size = UDim2.new(0.96, 0, 0.94, 0)
Scroll1.CanvasSize = UDim2.new(0, 0, 0, 0)
Scroll1.ScrollBarThickness = 3

local Layout1 = Instance.new("UIListLayout")
Layout1.Parent = Scroll1
Layout1.SortOrder = Enum.SortOrder.LayoutOrder
Layout1.Padding = UDim.new(0, 4)

ScanBtn1.MouseButton1Click:Connect(function()
    for _, child in ipairs(Scroll1:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    ScanBtn1.Text = "Scanning..."
    StatusLabel1.Text = "Loading..."
    StatusLabel1.TextColor3 = Color3.fromRGB(255, 200, 50)
    
    local foundServers = {}
    local cursor = ""
    
    for i = 1, 2 do
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then url = url .. "&cursor=" .. cursor end
        
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            for _, server in ipairs(result.data) do
                if server.playing and server.maxPlayers and server.id ~= game.JobId then
                    if server.playing <= 5 then
                        table.insert(foundServers, server)
                    end
                end
            end
            if result.nextPageCursor then
                cursor = result.nextPageCursor
            else
                break
            end
        else
            break
        end
    end
    
    if #foundServers > 0 then
        for idx, server in ipairs(foundServers) do
            local ServerRow = Instance.new("Frame")
            ServerRow.Parent = Scroll1
            ServerRow.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
            ServerRow.Size = UDim2.new(1, 0, 0, 36)
            
            local RowCorner = Instance.new("UICorner")
            RowCorner.CornerRadius = UDim.new(0, 5)
            RowCorner.Parent = ServerRow
            
            local InfoText = Instance.new("TextLabel")
            InfoText.Parent = ServerRow
            InfoText.BackgroundTransparency = 1
            InfoText.Position = UDim2.new(0.03, 0, 0, 0)
            InfoText.Size = UDim2.new(0.65, 0, 1, 0)
            InfoText.Font = Enum.Font.GothamMedium
            InfoText.Text = string.format("Players: %d/%d | ID: %s", server.playing, server.maxPlayers, string.sub(server.id, 1, 6))
            InfoText.TextColor3 = Color3.fromRGB(220, 220, 220)
            InfoText.TextSize = 10
            InfoText.TextXAlignment = Enum.TextXAlignment.Left
            
            local JoinBtn = Instance.new("TextButton")
            JoinBtn.Parent = ServerRow
            JoinBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 75)
            JoinBtn.Position = UDim2.new(0.7, 0, 0.15, 0)
            JoinBtn.Size = UDim2.new(0.26, 0, 0.7, 0)
            JoinBtn.Font = Enum.Font.GothamBold
            JoinBtn.Text = "JOIN"
            JoinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            JoinBtn.TextSize = 10
            
            local JoinCorner = Instance.new("UICorner")
            JoinCorner.CornerRadius = UDim.new(0, 4)
            JoinCorner.Parent = JoinBtn
            
            local targetId = server.id
            JoinBtn.MouseButton1Click:Connect(function()
                JoinBtn.Text = "..."
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetId, LocalPlayer)
            end)
        end
        Scroll1.CanvasSize = UDim2.new(0, 0, 0, #foundServers * 40)
        ScanBtn1.Text = "Scan All Servers"
        StatusLabel1.Text = string.format("Found: %d", #foundServers)
        StatusLabel1.TextColor3 = Color3.fromRGB(0, 220, 120)
    else
        ScanBtn1.Text = "Scan All Servers"
        StatusLabel1.Text = "No found"
        StatusLabel1.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

