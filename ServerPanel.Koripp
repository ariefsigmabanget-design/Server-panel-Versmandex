-- Key Validation Action
SubmitKeyBtn.MouseButton1Click:Connect(function()
    if KeyInput.Text == CORRECT_KEY then
        isFeature2Unlocked = true
        KeyStatus.Text = "Key Correct! Unlocking..."
        KeyStatus.TextColor3 = Color3.fromRGB(0, 220, 120)
        Tab2Btn.Text = "Feature 2"
        task.wait(0.8)
        KeyFrame.Visible = false
        Feature2Content.Visible = true
    else
        KeyStatus.Text = "Invalid Key! Try Again."
        KeyStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

local searchingActive2 = false

StartBtn2.MouseButton1Click:Connect(function()
    searchingActive2 = not searchingActive2
    if searchingActive2 then
        StartBtn2.Text = "Stop Searching"
        StartBtn2.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        
        task.spawn(function()
            while searchingActive2 do
                StatusLabel2.Text = "Loading..."
                StatusLabel2.TextColor3 = Color3.fromRGB(255, 200, 50)
                task.wait(0.8)
                
                local success, result = pcall(function()
                    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                    return HttpService:JSONDecode(game:HttpGet(url))
                end)
                
                local foundTarget = false
                if success and result and result.data then
                    for _, server in ipairs(result.data) do
                        if server.playing and server.maxPlayers and server.id ~= game.JobId then
                            if server.playing == 1 then
                                foundTarget = true
                                StatusLabel2.Text = "Found 1 Player Server! Joining..."
                                StatusLabel2.TextColor3 = Color3.fromRGB(0, 220, 120)
                                task.wait(1)
                                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                                break
                            end
                        end
                    end
                end
                
                if not foundTarget and searchingActive2 then
                    StatusLabel2.Text = "No found (1 Player)! Retrying..."
                    StatusLabel2.TextColor3 = Color3.fromRGB(255, 80, 80)
                    task.wait(2.5)
                end
            end
        end)
    else
        StartBtn2.Text = "Start Searching (1 Player)"
        StartBtn2.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        StatusLabel2.Text = "Status: Idle"
        StatusLabel2.TextColor3 = Color3.fromRGB(180, 180, 190)
    end
end)

-- Background Auto-Hop System
task.spawn(function()
    while true do
        task.wait(3)
        if autoHopEnabled1 then
            local currentPlayers = #Players:GetPlayers()
            if currentPlayers >= 4 then
                local success, result = pcall(function()
                    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                    return HttpService:JSONDecode(game:HttpGet(url))
                end)
                
                if success and result and result.data then
                    for _, server in ipairs(result.data) do
                        if server.playing and server.maxPlayers and server.id ~= game.JobId then
                            if server.playing <= 2 then
                                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                                break
                            end
                        end
                    end
                end
                break
            end
        end
    end
end)
