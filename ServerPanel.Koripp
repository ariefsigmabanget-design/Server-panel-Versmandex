    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(55, 55, 65)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 15, 18))
})

task.spawn(function()
    local offset = -1
    while MainFrame and MainFrame.Parent do
        offset = offset + 0.015
        if offset > 1 then offset = -1 end
        MainGradient.Offset = Vector2.new(offset, 0)
        task.wait(0.03)
    end
end)

